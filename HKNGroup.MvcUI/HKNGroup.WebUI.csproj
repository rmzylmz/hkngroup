<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Dil klasörlerini (cs, de, es, fr, it, ja, ko, pl, pt-BR, ru, zh-Hans, zh-Hant) engelle -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <!-- Hata ayıklama pdb dosyalarını publish çıktısından kaldır -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sadece Development / Debug ortamında çalışsın, publish'e refs ve Roslyn dll'lerini taşımasın -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.15" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.150.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HKNGroup.Domain\HKNGroup.Domain.csproj" />
    <ProjectReference Include="..\HKNGroup.Application\HKNGroup.Application.csproj" />
    <ProjectReference Include="..\HKNGroup.Persistence\HKNGroup.Persistence.csproj" />
  </ItemGroup>

</Project>
