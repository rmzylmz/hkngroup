@model ArticleCommentListDto

@{
    ViewBag.Title = "Yorumlar";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yorumlar</h4>
                <p class="text-muted font-size-13 mb-0">Makalelere yapılan ziyaretçi yorumlarını yönetin ve onaylayın</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Yorumlar</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (Model.ResultStatus == ResultStatus.Success)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
                <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                    Toplam @(Model?.Comments?.Count ?? 0) Yorum
                </span>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Yorum Sahibi</th>
                            <th>İlgili Makale</th>
                            <th>Yorum İçeriği</th>
                            <th class="text-center">Onay Durumu</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Comments != null && Model.Comments.Any())
                        {
                            @foreach (var item in Model.Comments)
                            {
                                <tr id="tr_@item.Id">
                                    <td class="fw-bold text-dark font-size-14">
                                        <i class="bx bx-user text-muted me-1"></i> @item.FirstName @item.LastName
                                    </td>
                                    <td>
                                        <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">
                                            @item.Article?.Title
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-muted font-size-13" style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Text">
                                            @item.Text
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge" style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
                                                <i class="bx bx-check"></i> Yayında
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: #fffbeb; color: #d97706; border: 1px solid #fde68a;">
                                                Onay Bekliyor
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm btn-primary" asp-controller="ArticleComment" asp-action="CheckIt" asp-route-id="@item.Id" title="Onayla / Yayına Al">
                                                <i class="bx bx-check"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="Sil(@item.Id)" title="Sil">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bx bx-comment-detail font-size-36 d-block mb-2 text-muted"></i>
                                    Henüz yapılmış bir yorum bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    function Sil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu yorumu silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "ArticleComment")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Yorum silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Yorum silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
