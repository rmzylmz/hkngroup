@model ProjectUpdateDto

@{
    ViewBag.Title = "Proje Düzenleme";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Proje Düzenle</h4>
                <p class="text-muted font-size-13 mb-0">Proje detaylarını ve galeri fotoğraflarını güncelleyin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Project">Projeler</a></li>
                    <li class="breadcrumb-item active">Düzenle</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <form method="post" asp-action="Edit" enctype="multipart/form-data">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4 p-3" style="border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bx bx-error-circle font-size-18"></i> Lütfen aşağıdaki hataları kontrol ediniz:
                    </div>
                    <div asp-validation-summary="All" class="text-danger font-size-13 mb-0" style="padding-left: 1.5rem;"></div>
                </div>
            }

            <input hidden asp-for="Id" />
            <input hidden asp-for="CoverImageUrl" />
            <input hidden asp-for="GalleryFiles" />

            <div class="row g-4">
                <!-- Sol Kolon: Temel Bilgiler (Geniş Alan) -->
                <div class="col-lg-8 col-xl-8 col-xxl-9">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectCategoryId" class="form-label fw-semibold">Proje Kategorisi <span class="text-danger">*</span></label>
                            <select asp-for="ProjectCategoryId" class="form-select form-control" asp-items="@(new SelectList(@ViewBag.ProjectCategoryList,"Id","Name"))">
                                <option value="">Lütfen kategori seçiniz...</option>
                            </select>
                            <span asp-validation-for="ProjectCategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Proje Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Proje Tarihi / Dönemi</label>
                            <input asp-for="ProjectDate" class="form-control" type="month" id="example-month-input" />
                            <span asp-validation-for="ProjectDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Proje Konumu / Şehir</label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShortContent" class="form-label fw-semibold">Kısa Tanıtım Metni</label>
                        <textarea asp-for="ShortContent" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ShortContent" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-semibold">Detaylı Proje Açıklaması <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" id="elm1" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <!-- Mevcut Galeri Fotoğrafları -->
                    @if (Model.ProjectImages != null && Model.ProjectImages.Any())
                    {
                        <div class="mb-3 pt-3 border-top">
                            <label class="form-label fw-semibold d-block mb-2">Mevcut Galeri Görselleri (@Model.ProjectImages.Count)</label>
                            <div class="row g-2">
                                @foreach (var img in Model.ProjectImages)
                                {
                                    <div class="col-6 col-sm-4 col-md-3" id="div_@img.Id">
                                        <div class="card p-1 mb-0 border position-relative overflow-hidden">
                                            <img src="/@img.URL" alt="" class="rounded" style="width: 100%; height: 90px; object-fit: cover;" />
                                            <button type="button" onclick="ProjectImagesSil(@img.Id)" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1" style="padding: 2px 6px; font-size: 11px;" title="Görseli Sil">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Sağ Kolon: Görseller, Durum ve SEO (Sağa Yaslı) -->
                <div class="col-lg-4 col-xl-4 col-xxl-3">
                    <!-- Kapak Görseli -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ana Kapak Görseli</label>

                        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                        {
                            <div class="existing-image-box w-100">
                                <span class="existing-image-badge"><i class="bx bx-image"></i> Mevcut Kapak</span>
                                <img src="/@Model.CoverImageUrl" alt="" class="img-fluid" />
                            </div>
                        }

                        <div class="file-dropzone">
                            <input type="file" name="FormFileCoverImageUrl" accept="image/*" />
                            <div class="file-dropzone-content">
                                <div class="file-dropzone-icon">
                                    <i class="bx bx-cloud-upload"></i>
                                </div>
                                <div class="file-dropzone-title">Kapak Görselini Değiştir</div>
                                <div class="file-dropzone-hint">Yeni görsel seçin veya sürükleyin</div>
                            </div>
                        </div>
                        <div class="file-preview-card">
                            <img class="file-preview-thumb" src="" alt="Önizleme" />
                            <div class="file-preview-details">
                                <div class="file-preview-name">kapak.jpg</div>
                                <div class="file-preview-size">0 KB</div>
                            </div>
                            <button type="button" class="file-preview-remove">Kaldır</button>
                        </div>
                        <span asp-validation-for="FormFileCoverImageUrl" class="text-danger"></span>
                    </div>

                    <!-- Yeni Galeri Görselleri Ekle -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Yeni Galeri Görselleri Ekle</label>
                        <div class="file-dropzone" style="padding: 1.25rem 1rem;">
                            <input type="file" multiple name="GalleryFiles" accept="image/*" id="galleryFileInput" />
                            <div class="file-dropzone-content">
                                <div class="file-dropzone-icon" style="width: 40px; height: 40px; font-size: 20px;">
                                    <i class="bx bx-images"></i>
                                </div>
                                <div class="file-dropzone-title">Fotoğraf Ekle (Çoklu)</div>
                                <div class="file-dropzone-hint">Galeriye yeni fotoğraflar ekleyin</div>
                            </div>
                        </div>
                        <div id="galleryCountBadge" class="mt-2 text-muted font-size-12" style="display: none;"></div>
                        <span asp-validation-for="GalleryFiles" class="text-danger"></span>
                    </div>

                    <div class="card p-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bx bx-cog text-primary"></i> Durum ve SEO</h6>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">Yayında (Aktif)</label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SeoTags" class="form-label font-size-13 text-muted">SEO Etiketleri</label>
                            <input asp-for="SeoTags" class="form-control" />
                            <span asp-validation-for="SeoTags" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="SeoDescription" class="form-label font-size-13 text-muted">Arama Motoru Açıklaması</label>
                            <textarea asp-for="SeoDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="SeoDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 mt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bx bx-arrow-back"></i> İptal
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-check"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </div>
    </form>
</div>

<script type="text/javascript">
    function ProjectImagesSil(id) {
        Swal.fire({
            title: "Görseli Sil?",
            text: "Bu fotoğraf galeriden kalıcı olarak kaldırılacaktır.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ProjectImagesDelete", "Project")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById("div_" + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Görsel silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Görsel silinirken bir sorun oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        var galleryInput = document.getElementById("galleryFileInput");
        var badge = document.getElementById("galleryCountBadge");
        if (galleryInput && badge) {
            galleryInput.addEventListener("change", function () {
                if (this.files && this.files.length > 0) {
                    badge.style.display = "block";
                    badge.innerHTML = `<span class="badge" style="background: #eff6ff; color: #2563eb;">${this.files.length} yeni fotoğraf seçildi</span>`;
                } else {
                    badge.style.display = "none";
                }
            });
        }
    });
</script>
