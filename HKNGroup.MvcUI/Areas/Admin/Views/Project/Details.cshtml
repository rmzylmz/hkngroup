@model ProjectDto

@{
    ViewBag.Title = "Proje Detayları";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">@Model.Project.Title</h4>
                <p class="text-muted font-size-13 mb-0">Proje detay ve önizlemesi</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Project">Projeler</a></li>
                    <li class="breadcrumb-item active">Detay</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Project.CoverImageUrl))
                {
                    <div class="mb-3 text-center">
                        <img src="/@Model.Project.CoverImageUrl" alt="@Model.Project.Title" class="img-fluid rounded" style="max-height: 380px; width: 100%; object-fit: cover;" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Project.ShortContent))
                {
                    <div class="p-3 mb-3 bg-light rounded text-muted font-size-14 fst-italic">
                        @Model.Project.ShortContent
                    </div>
                }

                <div class="project-content pt-2">
                    @Html.Raw(Model.Project.Content)
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3 border-bottom pb-2">Proje Bilgileri</h6>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Kategori:</span>
                    <span class="fw-semibold">@Model.Project.Category?.Name</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Project.Location))
                {
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Konum:</span>
                        <span class="fw-semibold">@Model.Project.Location</span>
                    </div>
                }

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Tarih / Dönem:</span>
                    <span class="fw-semibold">@Model.Project.ProjectDate</span>
                </div>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Kayıt Tarihi:</span>
                    <span class="fw-semibold">@Model.Project.CreatedTime.ToShortDateString()</span>
                </div>

                <div class="d-grid gap-2 pt-3 border-top mt-3">
                    <a asp-action="Edit" asp-controller="Project" asp-route-id="@Model.Project.Id" class="btn btn-primary">
                        <i class="bx bx-edit"></i> Düzenle
                    </a>
                    <a asp-action="Index" asp-controller="Project" class="btn btn-secondary">
                        <i class="bx bx-arrow-back"></i> Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
