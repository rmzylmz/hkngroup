@model ProjectListDto

@{
    ViewBag.Title = "Projeler";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Projeler</h4>
                <p class="text-muted font-size-13 mb-0">Portföy ve tamamlanan projelerinizi yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Projeler</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                Toplam @(Model?.Projects?.Count ?? 0) Proje
            </span>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> Yeni Proje Ekle
            </a>
        </div>

        @if (Model != null && Model.ResultStatus == ResultStatus.Success && Model.Projects != null && Model.Projects.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Görsel</th>
                            <th>Proje Adı</th>
                            <th>Kategori</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Projects)
                        {
                            <tr id="tr_@item.Id">
                                <td>
                                    <img src="/@(!string.IsNullOrEmpty(item.CoverImageUrl) ? item.CoverImageUrl : "admin/assets/images/no-img.jpg")" 
                                         alt="" style="width: 48px; height: 48px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark font-size-14">@item.Title</div>
                                    @if (!string.IsNullOrEmpty(item.Location))
                                    {
                                        <div class="text-muted font-size-12"><i class="bx bx-map-pin"></i> @item.Location</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">
                                        @item.Category?.Name
                                    </span>
                                </td>
                                <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-primary" asp-controller="Project" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="ProjectSil(@item.Id)" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-folder-open font-size-36 d-block mb-2 text-muted"></i>
                Henüz eklenmiş bir proje bulunmamaktadır.
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    function ProjectSil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu projeyi ve ilişkili görselleri silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "Project")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Proje silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Proje silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
