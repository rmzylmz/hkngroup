@model AdminUpdateDto

@{
    ViewBag.Title = "Yönetici Profilini Güncelle";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yönetici Profilini Güncelle</h4>
                <p class="text-muted font-size-13 mb-0">Admin paneli giriş bilgilerinizi (kullanıcı adı, e-posta ve şifre) düzenleyin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Setting">Hesap Bilgileri</a></li>
                    <li class="breadcrumb-item active">Profil Güncelle</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4 p-3" style="border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;">
                        <div class="fw-bold mb-1 d-flex align-items-center gap-2">
                            <i class="bx bx-error-circle font-size-18"></i> Lütfen aşağıdaki hataları kontrol ediniz:
                        </div>
                        <div asp-validation-summary="All" class="text-danger font-size-13 mb-0" style="padding-left: 1.5rem;"></div>
                    </div>
                }

                <form method="post" asp-action="EditAdmin">
                    <input hidden asp-for="Id" />
                    <input hidden asp-for="IsActive" />
                    <input hidden asp-for="IsDeleted" />

                    <!-- Kullanıcı Adı -->
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold">Kullanıcı Adı <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bx bx-user text-muted font-size-18"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="Örn: TOYOTAPARCAM2023" required />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                        <small class="text-muted">Admin paneline giriş yaparken kullandığınız kullanıcı adınız.</small>
                    </div>

                    <!-- E-Posta Adresi -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresi <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bx bx-envelope text-muted font-size-18"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="admin@hkngroup.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Yeni Şifre -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Yeni Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bx bx-lock-alt text-muted font-size-18"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="text-muted">Şifrenizi değiştirmek istemiyorsanız bu alanı boş bırakabilirsiniz.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 mt-4 border-top">
                        <a asp-action="Setting" class="btn btn-secondary">
                            <i class="bx bx-arrow-back"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-check"></i> Bilgileri Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
