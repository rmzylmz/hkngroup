@model AdminDto

@{
    ViewBag.Title = "Yönetici Ayarları";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yönetici Hesabı</h4>
                <p class="text-muted font-size-13 mb-0">Admin paneli giriş bilgilerinizi ve hesap detaylarını görüntüleyin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Yönetici Bilgileri</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <h5 class="card-title mb-0 d-flex align-items-center gap-2">
                <i class="bx bx-shield-quarter text-primary font-size-20"></i>
                Hesap Detayları
            </h5>
            <a class="btn btn-primary" asp-controller="Home" asp-action="EditAdmin" asp-route-id="@Model.Admin.Id">
                <i class="bx bx-edit"></i> Bilgileri Güncelle
            </a>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Kullanıcı Adı</th>
                        <th>E-Posta Adresi</th>
                        <th>Kayıt Tarihi</th>
                        <th>Son Güncelleme</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark font-size-14">
                            <i class="bx bx-user-circle text-primary font-size-18 me-1 align-middle"></i>
                            @Model.Admin.UserName
                        </td>
                        <td class="text-muted font-size-14">
                            <i class="bx bx-envelope text-muted font-size-16 me-1 align-middle"></i>
                            @Model.Admin.Email
                        </td>
                        <td class="text-muted font-size-13">@Model.Admin.CreatedTime.ToShortDateString()</td>
                        <td class="text-muted font-size-13">@Model.Admin.ModifiedTime.ToShortDateString()</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="EditAdmin" asp-route-id="@Model.Admin.Id" title="Düzenle">
                                <i class="bx bx-edit"></i> Bilgileri Güncelle
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
