@model ArticleCategoryListDto

@{
    ViewBag.Title = "Makale Kategorileri";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Makale Kategorileri</h4>
                <p class="text-muted font-size-13 mb-0">Haber ve makale gruplandırmalarını yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Article">Makaleler</a></li>
                    <li class="breadcrumb-item active">Kategoriler</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (Model.ResultStatus == ResultStatus.Success)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
                <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                    Toplam @(Model?.Categories?.Count ?? 0) Kategori
                </span>
                <a asp-action="Add" class="btn btn-primary">
                    <i class="bx bx-plus"></i> Yeni Kategori Ekle
                </a>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Görsel</th>
                            <th>Kategori Adı</th>
                            <th>Açıklama</th>
                            <th>Oluşturulma Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            @foreach (var item in Model.Categories)
                            {
                                <tr id="tr_@item.Id">
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CategoryFA))
                                        {
                                            <img src="@item.CategoryFA" alt="" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0;" />
                                        }
                                        else
                                        {
                                            <div style="width: 44px; height: 44px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                                <i class="bx bx-folder font-size-20"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-bold text-dark font-size-14">@item.Name</td>
                                    <td class="text-muted font-size-13">@item.Description</td>
                                    <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm btn-primary" asp-controller="ArticleCategory" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                                <i class="bx bx-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="Sil(@item.Id)" title="Sil">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Kayıtlı kategori bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    function Sil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu kategoriyi silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "ArticleCategory")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Kategori silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Kategori silinirken bir sorun oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
