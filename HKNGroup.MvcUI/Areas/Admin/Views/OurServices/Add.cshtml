@model OurServicesAddDto

@{
    ViewBag.Title = "Yeni Hizmet Ekle";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yeni Hizmet Ekle</h4>
                <p class="text-muted font-size-13 mb-0">Hizmet ve faaliyet alanlarınıza yenisini ekleyin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="OurServices">Hizmetler</a></li>
                    <li class="breadcrumb-item active">Yeni Ekle</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <form method="post" asp-action="Add" enctype="multipart/form-data">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4 p-3" style="border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bx bx-error-circle font-size-18"></i> Lütfen aşağıdaki hataları kontrol ediniz:
                    </div>
                    <div asp-validation-summary="All" class="text-danger font-size-13 mb-0" style="padding-left: 1.5rem;"></div>
                </div>
            }
            <div class="row g-4">
                <!-- Sol Kolon: Başlık ve Açıklama (Geniş Alan) -->
                <div class="col-lg-8 col-xl-8 col-xxl-9">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Hizmet Başlığı <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Otomotiv Yedek Parça İthalatı" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Detaylı Hizmet Tanıtımı <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" id="elm1" class="form-control" rows="10"></textarea>
                        <span class="text-danger" asp-validation-for="Description"></span>
                    </div>
                </div>

                <!-- Sağ Kolon: Görsel ve SEO (Sağa Yaslı) -->
                <div class="col-lg-4 col-xl-4 col-xxl-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hizmet Görseli <span class="text-danger">*</span></label>
                        <div class="file-dropzone">
                            <input type="file" name="fileImg" accept="image/*" />
                            <div class="file-dropzone-content">
                                <div class="file-dropzone-icon">
                                    <i class="bx bx-cloud-upload"></i>
                                </div>
                                <div class="file-dropzone-title">Görsel Seçin veya Sürükleyin</div>
                                <div class="file-dropzone-hint">PNG, JPG, WEBP (Önerilen: 800x600)</div>
                            </div>
                        </div>
                        <div class="file-preview-card">
                            <img class="file-preview-thumb" src="" alt="Önizleme" />
                            <div class="file-preview-details">
                                <div class="file-preview-name">hizmet.jpg</div>
                                <div class="file-preview-size">0 KB</div>
                            </div>
                            <button type="button" class="file-preview-remove">Kaldır</button>
                        </div>
                        <span class="text-danger" asp-validation-for="Images"></span>
                    </div>

                    <div class="card p-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                        <h6 class="fw-bold mb-2 text-dark"><i class="bx bx-search-alt text-primary"></i> Arama Motoru (SEO)</h6>
                        <div class="mb-3">
                            <label asp-for="SeoTags" class="form-label font-size-13 text-muted">Etiketler</label>
                            <input asp-for="SeoTags" class="form-control" placeholder="hizmet, servis, otomotiv" />
                            <span asp-validation-for="SeoTags" class="text-danger"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="SeoDescription" class="form-label font-size-13 text-muted">Arama Motoru Açıklaması</label>
                            <textarea asp-for="SeoDescription" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="SeoDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 mt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bx bx-arrow-back"></i> İptal
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-check"></i> Hizmeti Kaydet
                </button>
            </div>
        </div>
    </form>
</div>
