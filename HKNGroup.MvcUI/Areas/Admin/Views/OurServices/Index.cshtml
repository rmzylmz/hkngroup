@model OurServicesListDto

@{
    ViewBag.Title = "Hizmetlerimiz";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Hizmetlerimiz</h4>
                <p class="text-muted font-size-13 mb-0">Şirketinizin sunduğu hizmet ve faaliyet alanlarını yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Hizmetler</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                Toplam @(Model?.OurServices?.Count ?? 0) Hizmet
            </span>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> Yeni Hizmet Ekle
            </a>
        </div>

        @if (Model != null && Model.ResultStatus == ResultStatus.Success && Model.OurServices != null && Model.OurServices.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Görsel</th>
                            <th>Hizmet Başlığı</th>
                            <th>Açıklama Özeti</th>
                            <th>Kayıt Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OurServices)
                        {
                            <tr id="tr_@item.Id">
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Images))
                                    {
                                        <img src="/@item.Images" alt="" style="width: 48px; height: 48px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0;" />
                                    }
                                    else
                                    {
                                        <div style="width: 48px; height: 48px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                            <i class="bx bx-briefcase font-size-20"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold text-dark font-size-14">@item.Title</td>
                                <td>
                                    <div class="text-muted font-size-13" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 450px;">
                                        @Html.Raw(System.Text.RegularExpressions.Regex.Replace(item.Description ?? "", "<.*?>", string.Empty))
                                    </div>
                                </td>
                                <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-primary" asp-controller="OurServices" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="HizmetSil(@item.Id)" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-briefcase font-size-36 d-block mb-2 text-muted"></i>
                Henüz eklenmiş bir hizmet bulunmamaktadır.
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    function HizmetSil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu hizmet kaydını silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "OurServices")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Hizmet silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Hizmet silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
