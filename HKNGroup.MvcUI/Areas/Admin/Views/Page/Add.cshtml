@model PageAddDto

@{
    ViewBag.Title = "Yeni Sayfa Ekle";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yeni Sayfa Ekle</h4>
                <p class="text-muted font-size-13 mb-0">Hakkımızda, vizyon, misyon vb. içerik sayfası oluşturun</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Page">Sayfalar</a></li>
                    <li class="breadcrumb-item active">Yeni Ekle</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <form method="post" asp-action="Add" enctype="multipart/form-data">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4 p-3" style="border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bx bx-error-circle font-size-18"></i> Lütfen aşağıdaki hataları kontrol ediniz:
                    </div>
                    <div asp-validation-summary="All" class="text-danger font-size-13 mb-0" style="padding-left: 1.5rem;"></div>
                </div>
            }
            <div class="row g-4">
                <!-- Sol Kolon: Başlık ve İçerik (Geniş Alan) -->
                <div class="col-lg-8 col-xl-8 col-xxl-9">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="PageNumber" class="form-label fw-semibold">Sıra No</label>
                            <input asp-for="PageNumber" type="number" class="form-control" value="1" />
                            <span asp-validation-for="PageNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-9 mb-3">
                            <label asp-for="PageTitle" class="form-label fw-semibold">Sayfa Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="PageTitle" class="form-control" placeholder="Örn: Hakkımızda, Kalite Politikamız" />
                            <span asp-validation-for="PageTitle" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Sayfa İçeriği <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" id="elm1" class="form-control" rows="12"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- Sağ Kolon: Ayarlar ve SEO (Sağa Yaslı) -->
                <div class="col-lg-4 col-xl-4 col-xxl-3">
                    <div class="mb-3">
                        <label asp-for="IsMainPage" class="form-label fw-semibold">Anasayfada Gösterilsin mi?</label>
                        <select asp-for="IsMainPage" class="form-select">
                            <option value="False">Hayır (Sadece Menüden)</option>
                            <option value="True">Evet (Anasayfa Bloğu Olarak)</option>
                        </select>
                        <span class="text-danger" asp-validation-for="IsMainPage"></span>
                    </div>

                    <div class="card p-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bx bx-search-alt text-primary"></i> Arama Motoru (SEO)</h6>
                        <div class="mb-3">
                            <label asp-for="SEOTitle" class="form-label font-size-13 text-muted">SEO Başlığı</label>
                            <input asp-for="SEOTitle" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="SEOKeywords" class="form-label font-size-13 text-muted">Anahtar Kelimeler</label>
                            <input asp-for="SEOKeywords" class="form-control" placeholder="virgülle ayırınız" />
                        </div>
                        <div class="mb-2">
                            <label asp-for="SEODescription" class="form-label font-size-13 text-muted">Açıklama</label>
                            <textarea asp-for="SEODescription" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 mt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bx bx-arrow-back"></i> İptal
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-check"></i> Sayfayı Kaydet
                </button>
            </div>
        </div>
    </form>
</div>
