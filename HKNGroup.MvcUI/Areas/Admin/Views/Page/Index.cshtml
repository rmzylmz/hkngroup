@model PageListDto

@{
    ViewBag.Title = "Sayfalar";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Sayfalar</h4>
                <p class="text-muted font-size-13 mb-0">Hakkımızda, vizyon, misyon vb. kurumsal sayfaları yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Sayfalar</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                Toplam @(Model?.Page?.Count ?? 0) Sayfa
            </span>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> Yeni Sayfa Ekle
            </a>
        </div>

        @if (Model != null && Model.ResultStatus == ResultStatus.Success && Model.Page != null && Model.Page.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Sıra</th>
                            <th>Sayfa Başlığı</th>
                            <th class="text-center">Anasayfa Bloğu</th>
                            <th>Oluşturulma Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Page)
                        {
                            <tr id="tr_@item.Id">
                                <td>
                                    <span class="badge" style="background: #f1f5f9; color: #475569;">@item.PageNumber</span>
                                </td>
                                <td class="fw-bold text-dark font-size-14">
                                    <i class="bx bx-file-blank text-primary me-1"></i> @item.PageTitle
                                </td>
                                <td class="text-center">
                                    @if (item.IsMainPage)
                                    {
                                        <span class="badge" style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
                                            <i class="bx bx-check"></i> Evet
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: #f8fafc; color: #94a3b8; border: 1px solid #e2e8f0;">
                                            Hayır
                                        </span>
                                    }
                                </td>
                                <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-primary" asp-controller="Page" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="SayfaSil(@item.Id)" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-file-blank font-size-36 d-block mb-2 text-muted"></i>
                Henüz sayfa oluşturulmamış.
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    function SayfaSil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu sayfayı silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "Page")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Sayfa silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Sayfa silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
