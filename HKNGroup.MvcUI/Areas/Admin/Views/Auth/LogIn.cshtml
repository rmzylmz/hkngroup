@model AdminLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Giriş Yap | HKN Group Yönetim Paneli</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="~/admin/assets/images/favicon.ico">
    <link href="~/admin/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/admin/custom/admin.css" rel="stylesheet" type="text/css" />
    <style>
        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-xl);
            overflow: hidden;
        }
        .login-header {
            padding: 2rem 1.5rem 1.5rem 1.5rem;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
            background: #ffffff;
        }
        .login-body {
            padding: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--primary); color: #fff; margin: 0 auto 12px auto; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">
                    H
                </div>
                <h4 style="font-weight: 700; color: var(--text-main); margin-bottom: 4px;">HKN Group</h4>
                <p style="font-size: 13px; color: var(--text-muted); margin: 0;">Yönetim Paneli Girişi</p>
            </div>

            <div class="login-body">
                <form asp-area="Admin" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 13px; padding: 0.5rem; background: rgba(239, 68, 68, 0.1); border-radius: 6px; border: 1px solid rgba(239, 68, 68, 0.2);"></div>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold">Kullanıcı Adı veya E-Posta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bx bx-user text-muted font-size-18"></i></span>
                            <input class="form-control" asp-for="UserName" placeholder="Kullanıcı adı veya e-posta..." required autofocus />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bx bx-lock-alt text-muted font-size-18"></i></span>
                            <input class="form-control" asp-for="Password" type="password" placeholder="Şifrenizi girin..." required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div style="margin-top: 1.5rem;">
                        <button class="btn btn-primary" style="width: 100%; padding: 0.75rem;" type="submit" data-loading-text="Giriş yapılıyor...">
                            <i class="bx bx-log-in"></i> Güvenli Giriş Yap
                        </button>
                    </div>
                </form>
            </div>

            <div style="padding: 1rem 1.5rem; text-align: center; border-top: 1px solid var(--border-color); font-size: 12px; color: var(--text-dim);">
                © @DateTime.Now.Year HKN Group. Tüm hakları saklıdır.
            </div>
        </div>
    </div>

    <script src="~/admin/custom/admin.js"></script>
</body>
</html>
