@{
    ViewBag.Title = "Şifremi Unuttum - HKN Group Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="~/admin/assets/images/favicon.ico">
    <link href="~/admin/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/admin/custom/admin.css" rel="stylesheet" />
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <h1>HKN<span>GROUP</span></h1>
            <p>Şifre Sıfırlama</p>
        </div>

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
            <div class="form-group mb-3">
                <label class="form-label font-size-13 text-muted">Güvenlik Sorusu</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bx bx-help-circle text-muted"></i></span>
                    <input class="form-control" type="text" value="@ViewBag.SQ" disabled />
                </div>
            </div>

            <div class="form-group mb-4">
                <label class="form-label font-size-13 text-muted">Güvenlik Sorusu Cevabı</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bx bx-key text-muted"></i></span>
                    <input class="form-control" name="sqAnswer" type="text" placeholder="Cevabınızı giriniz..." required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bx bx-sync"></i> Şifremi Yenile
            </button>
        </form>

        <div class="auth-footer mt-4 text-center">
            <a asp-action="Login" asp-controller="Auth" class="font-size-13 text-muted">
                <i class="bx bx-arrow-back"></i> Giriş Ekranına Dön
            </a>
        </div>
    </div>
</body>
</html>
