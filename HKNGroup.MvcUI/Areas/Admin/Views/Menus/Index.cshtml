@model List<MenuItemDto>
@{
    ViewData["Title"] = "Menüler";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
    <li class="breadcrumb-item">Menüler Listesi</li>
</ol>

<script type="text/javascript">
    function MenuDelete(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu menüyü ve varsa tüm alt menülerini silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '/Admin/Menus/DoHardDelete/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById("menu_item_" + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Menü başarıyla silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Menü silinirken bir sorun oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>

<div class="card mb-4">
    <div class="card-body">
        <div class="row mb-3 border-bottom">
            <div class="col-sm-6">
                <h5 class="card-title d-flex align-items-center gap-2">
                    <i class="bx bx-menu text-primary font-size-20"></i>
                    Menü Hiyerarşisi
                </h5>
                <p class="text-muted font-size-13 mb-0">Sitenizin üst ve alt menü yapısını yönetin</p>
            </div>
            <div class="col-sm-6 text-sm-end">
                <a asp-action="Add" class="btn btn-primary btn-rounded">
                    <i class="bx bx-plus"></i> Yeni Menü Ekle
                </a>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="menu-tree-list mt-3">
                @{
                    async Task RenderMenu(List<MenuItemDto> items, bool isChild = false)
                    {
                        <ul class="@(isChild ? "menu-children-container" : "menu-tree-list")">
                            @foreach (var item in items)
                            {
                                var hasChildren = item.Children != null && item.Children.Any();
                                <li class="menu-tree-item" id="menu_item_@item.Id">
                                    <div class="@(isChild ? "menu-child-node" : "menu-node")">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1 overflow-hidden me-3">
                                            @if (isChild)
                                            {
                                                <i class="bx bx-subdirectory-right text-primary font-size-18"></i>
                                            }
                                            else
                                            {
                                                <i class="bx @(hasChildren ? "bxs-folder text-primary" : "bx-link text-muted") font-size-18"></i>
                                            }

                                            <span class="fw-bold text-dark font-size-14">@Html.Raw(item.Name)</span>

                                            @if (!string.IsNullOrEmpty(item.Url) && item.Url != "#")
                                            {
                                                <code class="d-none d-md-inline" style="background: #f1f5f9; color: #64748b; padding: 2px 6px; border-radius: 4px; font-size: 11.5px;">@item.Url</code>
                                            }

                                            @if (item.MenuRow.HasValue)
                                            {
                                                <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; font-size: 11px;">
                                                    Sıra: @item.MenuRow
                                                </span>
                                            }

                                            @if (item.YanSekme)
                                            {
                                                <span class="badge badge-info d-none d-sm-inline-flex" style="font-size: 10.5px;" title="Yeni sekmede açılır">
                                                    <i class="bx bx-window-open me-1"></i> Yeni Sekme
                                                </span>
                                            }
                                        </div>

                                        <div class="d-flex align-items-center gap-1 flex-shrink-0" id="deleteButton_@item.Id">
                                            <a class="btn btn-sm btn-primary" href="/Admin/Menus/Edit/@item.Id" title="Düzenle">
                                                <i class="bx bx-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="MenuDelete(@item.Id)" title="Sil">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                    @if (hasChildren)
                                    {
                                        await RenderMenu(item.Children, true);
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
                @{
                    await RenderMenu(Model, false);
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-folder-open font-size-24 mb-2 d-block"></i>
                <p>Henüz tanımlanmış bir menü bulunmamaktadır.</p>
                <a asp-action="Add" class="btn btn-primary btn-sm mt-2">
                    <i class="bx bx-plus"></i> İlk Menüyü Ekle
                </a>
            </div>
        }
    </div>
</div>
