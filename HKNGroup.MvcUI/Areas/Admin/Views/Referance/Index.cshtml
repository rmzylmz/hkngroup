@model ReferanceListDto

@{
    ViewData["Title"] = "Referanslar";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Referanslar</h4>
                <p class="text-muted font-size-13 mb-0">İş ortakları ve müşteri referanslarını yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Referans Listesi</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                Toplam @(Model?.Referances?.Count ?? 0) Referans
            </span>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> Yeni Referans Ekle
            </a>
        </div>

        @if (Model != null && Model.ResultStatus == ResultStatus.Success && Model.Referances != null && Model.Referances.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Logo</th>
                            <th>Referans / Kurum Adı</th>
                            <th style="width: 100px;">Sıra</th>
                            <th>Eklenme Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Referances)
                        {
                            <tr id="tr_@item.Id">
                                <td>
                                    <div style="width: 60px; height: 42px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; display: flex; align-items: center; justify-content: center; padding: 4px;">
                                        <img src="/@(!string.IsNullOrEmpty(item.Thumbnail) ? item.Thumbnail : "admin/assets/images/no-img.jpg")" 
                                             alt="" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                    </div>
                                </td>
                                <td class="fw-bold text-dark font-size-14">@item.Title</td>
                                <td>
                                    <span class="badge" style="background: #f1f5f9; color: #475569;">@item.RowNumbar</span>
                                </td>
                                <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-primary" asp-controller="Referance" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="SilReferance(@item.Id)" title="Sil">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-building font-size-36 d-block mb-2 text-muted"></i>
                Henüz referans eklenmemiş.
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    function SilReferance(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu referansı silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "Referance")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Referans silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Referans silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
