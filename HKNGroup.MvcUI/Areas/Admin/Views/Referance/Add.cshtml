@model ReferanceAddDto
@{
    ViewData["Title"] = "Yeni Referans Ekle";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Yeni Referans Ekle</h4>
                <p class="text-muted font-size-13 mb-0">Referanslarınıza yeni bir kurum veya müşteri logosu ekleyin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Referance">Referanslar</a></li>
                    <li class="breadcrumb-item active">Yeni Ekle</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <form method="post" asp-action="Add" enctype="multipart/form-data">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4 p-3" style="border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626;">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bx bx-error-circle font-size-18"></i> Lütfen aşağıdaki hataları kontrol ediniz:
                    </div>
                    <div asp-validation-summary="All" class="text-danger font-size-13 mb-0" style="padding-left: 1.5rem;"></div>
                </div>
            }
            <div class="row g-4">
                <!-- Sol Kolon: Başlık ve Sıra -->
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Kurum / Firma Adı <span class="text-danger">*</span></label>
                        <input class="form-control" asp-for="Title" placeholder="Örn: X Holding" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RowNumbar" class="form-label fw-semibold d-block">Görüntülenme Sırası</label>
                        <input asp-for="RowNumbar" type="number" class="form-control" style="max-width: 200px; display: block;" value="1" />
                        <span asp-validation-for="RowNumbar" class="text-danger"></span>
                    </div>
                </div>

                <!-- Sağ Kolon: Logo Dropzone -->
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Referans Logosu <span class="text-danger">*</span></label>
                        <div class="file-dropzone">
                            <input type="file" name="Thumbnail" accept="image/*" />
                            <div class="file-dropzone-content">
                                <div class="file-dropzone-icon">
                                    <i class="bx bx-cloud-upload"></i>
                                </div>
                                <div class="file-dropzone-title">Logo Seçin veya Sürükleyin</div>
                                <div class="file-dropzone-hint">PNG (Şeffaf arkaplan önerilir), SVG, WEBP, JPG</div>
                            </div>
                        </div>
                        <div class="file-preview-card">
                            <img class="file-preview-thumb" src="" alt="Önizleme" />
                            <div class="file-preview-details">
                                <div class="file-preview-name">logo.png</div>
                                <div class="file-preview-size">0 KB</div>
                            </div>
                            <button type="button" class="file-preview-remove">Kaldır</button>
                        </div>
                        <span asp-validation-for="Thumbnail" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 mt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bx bx-arrow-back"></i> İptal
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-check"></i> Referansı Kaydet
                </button>
            </div>
        </div>
    </form>
</div>
