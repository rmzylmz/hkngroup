@model PopupMessagesListDto

@{
    ViewData["Title"] = "Açılır Mesajlar (Pop-up)";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Açılır Mesajlar (Pop-up)</h4>
                <p class="text-muted font-size-13 mb-0">Ziyaretçilere sitede gösterilecek duyuru ve pop-up pencerelerini yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Açılır Mesajlar</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
            <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                Toplam @(Model?.PopupMessages?.Count ?? 0) Mesaj
            </span>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bx bx-plus"></i> Yeni Açılır Mesaj Ekle
            </a>
        </div>

        @if (Model != null && Model.ResultStatus == ResultStatus.Success && Model.PopupMessages != null && Model.PopupMessages.Any())
        {
            <div class="row g-3">
                @foreach (var item in Model.PopupMessages)
                {
                    <div class="col-12 col-md-6 col-lg-4" id="div_@item.Id">
                        <div class="card h-100 border shadow-none" style="overflow: hidden; border-radius: 12px;">
                            <div style="position: relative; height: 180px; background: #0f172a;">
                                <img src="@item.Thumbnail" alt="@item.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                                <span class="badge position-absolute top-0 start-0 m-2" style="background: rgba(15, 23, 42, 0.75); color: #fff; backdrop-filter: blur(4px);">
                                    Sıra: @item.RowNumbar
                                </span>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between p-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1 font-size-15">@item.Title</h6>
                                    <p class="text-muted font-size-13 mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @item.Description
                                    </p>
                                    @if (!string.IsNullOrEmpty(item.MessageUrl) && item.MessageUrl != "#")
                                    {
                                        <div class="font-size-12 text-primary text-truncate mb-2"><i class="bx bx-link"></i> @item.MessageUrl</div>
                                    }
                                </div>
                                <div class="d-flex justify-content-end gap-1 pt-2 border-top">
                                    <a class="btn btn-sm btn-primary" asp-controller="PopupMessage" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                        <i class="bx bx-edit"></i> Düzenle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="SilSlider(@item.Id)" title="Sil">
                                        <i class="bx bx-trash"></i> Sil
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bx bx-bell font-size-36 d-block mb-2 text-muted"></i>
                Henüz açılır mesaj eklenmemiş.
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    function SilSlider(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu açılır mesajı silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "PopupMessage")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById("div_" + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Açılır mesaj silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Açılır mesaj silinirken bir sorun oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
