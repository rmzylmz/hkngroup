@model ArticleDto

@{
    ViewBag.Title = "Makale Detayları";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">@Model.Article.Title</h4>
                <p class="text-muted font-size-13 mb-0">Makale detay ve içerik önizlemesi</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Article">Makaleler</a></li>
                    <li class="breadcrumb-item active">Detay</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Article.Thumbnail))
                {
                    <div class="mb-3 text-center">
                        <img src="@Model.Article.Thumbnail" alt="@Model.Article.Title" class="img-fluid rounded" style="max-height: 340px; width: 100%; object-fit: cover;" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Article.ShortContent))
                {
                    <div class="p-3 mb-3 bg-light rounded text-muted font-size-14 fst-italic">
                        @Model.Article.ShortContent
                    </div>
                }

                <div class="article-content pt-2">
                    @Html.Raw(Model.Article.Content)
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3 border-bottom pb-2">Makale Bilgileri</h6>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Kategori:</span>
                    <span class="fw-semibold">@Model.Article.Category?.Name</span>
                </div>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Okunma:</span>
                    <span class="fw-semibold"><i class="bx bx-show"></i> @Model.Article.ViewsCount</span>
                </div>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Yorumlar:</span>
                    <span class="fw-semibold"><i class="bx bx-comment-dots"></i> @(Model.Article.Comments?.Count ?? 0)</span>
                </div>

                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Yayın Tarihi:</span>
                    <span class="fw-semibold">@Model.Article.CreatedTime.ToShortDateString()</span>
                </div>

                <div class="mb-3 d-flex justify-content-between">
                    <span class="text-muted">Durum:</span>
                    @if (Model.Article.IsActive)
                    {
                        <span class="badge" style="background: #ecfdf5; color: #059669;">Yayında</span>
                    }
                    else
                    {
                        <span class="badge" style="background: #fef2f2; color: #dc2626;">Taslak</span>
                    }
                </div>

                <div class="d-grid gap-2 pt-3 border-top">
                    <a asp-action="Edit" asp-controller="Article" asp-route-id="@Model.Article.Id" class="btn btn-primary">
                        <i class="bx bx-edit"></i> Düzenle
                    </a>
                    <a asp-action="Index" asp-controller="Article" class="btn btn-secondary">
                        <i class="bx bx-arrow-back"></i> Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
