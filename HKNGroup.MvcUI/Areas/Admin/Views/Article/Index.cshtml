@model ArticleListDto

@{
    ViewBag.Title = "Makale Listesi";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 font-size-18 fw-bold">Makaleler</h4>
                <p class="text-muted font-size-13 mb-0">Yayınlanmış tüm haber ve makaleleri yönetin</p>
            </div>
            <div>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Admin</a></li>
                    <li class="breadcrumb-item active">Makale Listesi</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (Model.ResultStatus == ResultStatus.Success)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3">
                <span class="badge" style="background: #eff6ff; color: #2563eb; font-weight: 600; padding: 6px 12px; font-size: 13px;">
                    Toplam @(Model.Articles?.Count ?? 0) Makale
                </span>
                <a asp-action="Add" class="btn btn-primary">
                    <i class="bx bx-plus"></i> Yeni Makale Ekle
                </a>
            </div>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th class="text-center">Okunma</th>
                            <th class="text-center">Yorum</th>
                            <th>Yayın Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Articles != null && Model.Articles.Any())
                        {
                            @foreach (var item in Model.Articles)
                            {
                                <tr id="tr_@item.Id">
                                    <td class="fw-semibold text-dark">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.Thumbnail))
                                            {
                                                <img src="@item.Thumbnail" alt="" style="width: 38px; height: 38px; border-radius: 6px; object-fit: cover; border: 1px solid #e2e8f0;" />
                                            }
                                            else
                                            {
                                                <div style="width: 38px; height: 38px; border-radius: 6px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                                    <i class="bx bx-news font-size-18"></i>
                                                </div>
                                            }
                                            <span>@item.Title</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;">
                                            @item.Category?.Name
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted"><i class="bx bx-show me-1"></i>@item.ViewsCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted"><i class="bx bx-comment-dots me-1"></i>@(item.Comments?.Count ?? 0)</span>
                                    </td>
                                    <td class="text-muted font-size-13">@item.CreatedTime.ToShortDateString()</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm btn-primary" asp-controller="Article" asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                                <i class="bx bx-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="Sil(@item.Id)" title="Sil">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Kayıtlı makale bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    function Sil(id) {
        Swal.fire({
            title: "Emin misiniz?",
            text: "Bu makaleyi silmek istediğinize emin misiniz?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DoHardDelete", "Article")/' + id,
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function () {
                        var el = document.getElementById('tr_' + id);
                        if (el) el.remove();
                        Swal.fire({
                            title: "Başarılı",
                            text: "Makale silindi.",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Hata",
                            text: "Makale silinirken hata oluştu.",
                            icon: "error",
                            confirmButtonText: "Tamam"
                        });
                    }
                });
            }
        });
    }
</script>
