@model HKNGroup.WebUI.Models.ProjectViewModel;

@{
    ViewBag.SeoTitle = "Proje Kategorileri";
    ViewBag.SeoDescription = Model.SiteSetting.SiteDescription;
    ViewBag.SeoKeywords = Model.SiteSetting.SiteKeyword;
}
<partial name="~/Views/Shared/Partials/Breadcumb/Index.cshtml" />


@if (Model.ProjectList.Count > 0)
    {
        <section class="space-top space-extra-bottom">
            <div class="container">
                <div class="row gy-4">
                    @foreach (var item in Model.ProjectList)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="blog-card">
                                <div class="blog-img">
                                    <img src="@item.siteBaseUrl@item.CoverImageUrl" alt="@item.Title">
                                </div>
                                <div class="blog-content">

                                    <h3 class="blog-title box-title proje-title">
                                        <a href="/@RoutingEnum.Proje/@item.Url">@item.Title</a>
                                    </h3>
                                    <div class="description">
                                        <p class="blog-text">@item.ShortContent</p>
                                    </div>
                                    <a href="/@RoutingEnum.Proje/@item.Url" class="gr-link">Projenin Detayına Git</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="cta-sec background-image mt-4 mb-4" style="background-image: url(/assets/img/bg/cta_bg_5.jpg);">
            <div class="container">
                <div class="row gy-40 align-items-center justify-content-between">
                    <div class="col-lg-6">
                        <h4 class="sec-title text-white mb-10">Proje Detayları Yükleniyor.</h4>
                        <p class="text-white mb-n2">Daha fazla bilgi ve ayrıntı için bizimle iletişime geçmekten memnuniyet duyarız.</p>
                    </div>
                    <div class="col-lg-auto">
                        <a href="tel:+02167557376" class="call-btn">
                            <div class="play-btn style4">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="btn-content">
                                <span class="btn-text text-white">BİZİ ARAYIN</span>
                                <span class="box-title gr-text">02167557376</span>
                            </div>
                        </a>
                    </div><div class="col-lg-auto"><a asp-action="Index" asp-controller="Contact" class="as-btn gr-btn">İletişime Geç</a></div>
                </div>
            </div>
        </section>
    }
 

<style>
    .proje-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .description {
        width: 100%;
        max-width: 450px;
        margin: 0 auto;
        height: 90px;
        margin-bottom: 5px;
    }

    .description {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
