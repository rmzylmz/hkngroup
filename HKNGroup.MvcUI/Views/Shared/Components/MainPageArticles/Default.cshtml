@model ArticleListDto
<section class="space">
    <div class="container">
        <div class="title-area text-center">

            <h2 class="sec-title">Bizden Yazılar</h2>
            <p class="sec-text ms-auto me-auto">İnşaat Projelerimiz, Şirketimiz ile ilgili güncel haber ve duyurular.</p>
        </div>
        <div class="row slider-shadow as-carousel" data-slide-show="3" data-ml-slide-show="2" data-lg-slide-show="2" data-md-slide-show="2" data-sm-slide-show="1" data-arrows="true">
            @foreach (var item in Model.Articles)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="blog-box">
                        <div class="blog-img">
                            <img src="@item.siteBaseUrl@item.Thumbnail" alt="@item.Title">
                        </div>
                        <div class="blog-content">
                            <a class="date" href="#">
                                <span class="gr-text">12</span>
                                Haz
                            </a>
                            <div class="blog-meta">
                                <a href="#">
                                    <i class="far fa-tag"></i>
                                    @item.Category.Name
                                </a>
                                <a href="#">
                                    <i class="fal fa-comment"></i>
                                    Yorumlar ( @item.Comments.Count)
                                </a>
                            </div>
                            <h3 class="blog-title box-title">
                                <a href="/@RoutingEnum.HaberDetay/@item.Url">@item.Title</a>
                            </h3>
                            <div class="blog1">
                                <p class="blog-text">@Html.Raw(item.Content)</p>
                            </div>

                            <a href="/@RoutingEnum.HaberDetay/@item.Url" class="gr-link mt-2">Devamı Oku</a>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</section>
<style>
    .blog1 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height:90px;
    }

</style>

